# Copier ce fichier vers .env puis adapter les valeurs locales.
# Ne JAMAIS committer .env, .env.dev ni .env.local (secrets réels).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_32_characters_abcdefghij
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://postgres:change_me@127.0.0.1:5432/covocam_db?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change_me_passphrase
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:password@smtp.example.com:465?encryption=ssl&auth_mode=login
MAILER_SENDER_EMAIL=no-reply@example.com
MAILER_SENDER_NAME="CovoCam"
###< symfony/mailer ###

###> campay ###
CAMPAY_APP_CODE=change_me
CAMPAY_APP_PASSWORD=change_me
PAYMENT_MODE=simulation
PLATFORM_COMMISSION_RATE=0.10
ADMIN_PHONE=237600000000
###< campay ###
